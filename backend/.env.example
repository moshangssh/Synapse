# LLM 配置
LLM_API_KEY=your_api_key_here
LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-3.5-turbo
LLM_TIMEOUT=30
LLM_MAX_RETRIES=3

# 缓存配置
CACHE_ENABLED=true
CACHE_MAX_SIZE=1000
CACHE_TTL=3600

# 应用配置
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:1420,tauri://localhost